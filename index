<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#ffffff">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title>OPIcGrade — IH→AL</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #ffffff;
    --bg2: #f5f5f4;
    --bg3: #eeede9;
    --text: #1a1a1a;
    --text2: #6b6b6b;
    --text3: #a0a0a0;
    --border: rgba(0,0,0,0.1);
    --border2: rgba(0,0,0,0.18);
    --purple: #534AB7;
    --purple-light: #EEEDFE;
    --purple-text: #3C3489;
    --teal: #1D9E75;
    --teal-light: #E1F5EE;
    --teal-text: #085041;
    --amber: #EF9F27;
    --amber-light: #FAEEDA;
    --amber-text: #633806;
    --red: #E24B4A;
    --red-light: #FCEBEB;
    --red-text: #A32D2D;
    --radius: 12px;
    --radius-sm: 8px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1c1c1e;
      --bg2: #2c2c2e;
      --bg3: #3a3a3c;
      --text: #f2f2f7;
      --text2: #aeaeb2;
      --text3: #6c6c70;
      --border: rgba(255,255,255,0.1);
      --border2: rgba(255,255,255,0.2);
      --purple-light: #2a2650;
      --purple-text: #AFA9EC;
      --teal-light: #0d3326;
      --teal-text: #5DCAA5;
      --amber-light: #3a2800;
      --amber-text: #FAC775;
      --red-light: #3a1010;
      --red-text: #F09595;
    }
  }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  html, body { height: 100%; background: var(--bg3); font-family: 'Pretendard', -apple-system, sans-serif; }

  .app {
    max-width: 430px; margin: 0 auto;
    min-height: 100vh; background: var(--bg);
    display: flex; flex-direction: column;
  }

  .screen { display: none; flex-direction: column; flex: 1; }
  .screen.active { display: flex; }

  .top-nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 20px 12px;
    border-bottom: 0.5px solid var(--border);
    background: var(--bg);
    position: sticky; top: 0; z-index: 10;
  }
  .nav-logo { font-size: 18px; font-weight: 500; color: var(--text); letter-spacing: -0.3px; }
  .nav-logo span { color: var(--teal); }
  .nav-badge {
    font-size: 12px; font-weight: 500; padding: 4px 12px; border-radius: 20px;
    background: var(--purple-light); color: var(--purple-text);
    display: flex; align-items: center; gap: 5px;
  }

  .scroll-body { flex: 1; overflow-y: auto; padding: 20px; -webkit-overflow-scrolling: touch; }

  .section-label {
    font-size: 11px; font-weight: 500; text-transform: uppercase;
    letter-spacing: .08em; color: var(--text3); margin-bottom: 8px;
  }

  /* API Key */
  .api-card {
    background: var(--bg2); border-radius: var(--radius);
    padding: 14px 16px; margin-bottom: 20px;
    border: 0.5px solid var(--border);
  }
  .api-row { display: flex; gap: 8px; margin-top: 8px; }
  .api-input {
    flex: 1; padding: 10px 12px; border-radius: var(--radius-sm);
    border: 0.5px solid var(--border2); background: var(--bg);
    font-size: 13px; color: var(--text); font-family: monospace;
    outline: none;
  }
  .api-input:focus { border-color: var(--purple); }
  .api-btn {
    padding: 10px 16px; border-radius: var(--radius-sm); border: none;
    background: var(--purple); color: white;
    font-size: 13px; font-weight: 500; cursor: pointer; white-space: nowrap;
  }
  .api-ok {
    font-size: 12px; color: var(--teal); margin-top: 8px;
    display: none; align-items: center; gap: 5px;
  }
  .api-ok.show { display: flex; }

  /* Question */
  .q-meta { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
  .pill {
    font-size: 11px; font-weight: 500; padding: 4px 11px; border-radius: 20px;
    display: inline-flex; align-items: center; gap: 4px;
  }
  .pill-purple { background: var(--purple-light); color: var(--purple-text); }
  .pill-amber { background: var(--amber-light); color: var(--amber-text); }
  .q-text {
    font-size: 15px; line-height: 1.6; color: var(--text);
    padding: 14px 16px; background: var(--bg2);
    border-left: 3px solid var(--purple); border-radius: 0 var(--radius) var(--radius) 0;
    margin-bottom: 16px;
  }
  .al-tip {
    background: var(--purple-light); border-radius: var(--radius);
    padding: 12px 14px; margin-bottom: 20px;
    font-size: 13px; color: var(--purple-text); line-height: 1.55;
    display: flex; gap: 10px; align-items: flex-start;
  }
  .al-tip-icon { font-size: 16px; flex-shrink: 0; margin-top: 1px; }

  /* Record */
  .rec-zone {
    border: 1.5px dashed var(--border2); border-radius: 16px;
    padding: 28px 20px; display: flex; flex-direction: column;
    align-items: center; gap: 14px; margin-bottom: 16px;
    cursor: pointer; transition: border-color .2s; background: var(--bg);
    -webkit-user-select: none; user-select: none;
  }
  .rec-zone:active { background: var(--bg2); }
  .rec-zone.recording { border-color: var(--red); border-style: solid; }

  .mic-btn {
    width: 68px; height: 68px; border-radius: 50%; border: none;
    background: var(--teal); display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: all .2s; -webkit-user-select: none;
  }
  .mic-btn.on { background: var(--red); animation: rp 1.2s infinite; }
  .mic-icon { font-size: 28px; }

  @keyframes rp {
    0%,100% { box-shadow: 0 0 0 0 rgba(226,75,74,.3); }
    60% { box-shadow: 0 0 0 12px rgba(226,75,74,0); }
  }

  .wave { display: flex; align-items: center; gap: 4px; height: 32px; opacity: 0; transition: opacity .3s; }
  .wave.on { opacity: 1; }
  .wb { width: 4px; border-radius: 2px; background: var(--red); animation: wv .9s ease-in-out infinite; }
  .wb:nth-child(2){animation-delay:.1s}.wb:nth-child(3){animation-delay:.2s}
  .wb:nth-child(4){animation-delay:.3s}.wb:nth-child(5){animation-delay:.2s}.wb:nth-child(6){animation-delay:.1s}
  @keyframes wv { 0%,100%{height:6px} 50%{height:26px} }

  .rec-label { font-size: 14px; color: var(--text2); }
  .rec-time { font-size: 13px; font-weight: 500; color: var(--text2); letter-spacing: .05em; display: none; }

  .transcript {
    background: var(--bg2); border-radius: var(--radius);
    padding: 14px 16px; margin-bottom: 16px; display: none;
    border: 0.5px solid var(--border);
  }
  .transcript.show { display: block; }
  .t-label { font-size: 10px; font-weight: 500; text-transform: uppercase; letter-spacing: .08em; color: var(--text3); margin-bottom: 8px; }
  .t-text { font-size: 14px; line-height: 1.7; color: var(--text); min-height: 44px; }

  /* Buttons */
  .btn-primary {
    width: 100%; padding: 15px; background: var(--teal); color: white;
    border: none; border-radius: var(--radius); font-size: 16px; font-weight: 500;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    gap: 8px; transition: background .2s; -webkit-user-select: none;
  }
  .btn-primary:active { background: var(--teal-text); }
  .btn-primary:disabled { background: var(--bg3); color: var(--text3); cursor: not-allowed; }
  .btn-secondary {
    width: 100%; padding: 13px; margin-top: 10px; background: transparent;
    border: 0.5px solid var(--border2); border-radius: var(--radius);
    font-size: 14px; color: var(--text2); cursor: pointer;
  }
  .btn-secondary:active { background: var(--bg2); }

  .err-msg {
    font-size: 13px; color: var(--red-text); background: var(--red-light);
    padding: 10px 14px; border-radius: var(--radius-sm);
    margin-top: 10px; display: none; line-height: 1.5;
  }
  .err-msg.show { display: block; }

  /* Loading */
  .load-body {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 20px; padding: 40px 24px;
  }
  .spinner {
    width: 48px; height: 48px; border-radius: 50%;
    border: 3px solid var(--border2); border-top-color: var(--purple);
    animation: sp .8s linear infinite;
  }
  @keyframes sp { to { transform: rotate(360deg); } }
  .load-title { font-size: 15px; font-weight: 500; color: var(--text); }
  .load-steps { width: 100%; max-width: 260px; display: flex; flex-direction: column; gap: 10px; }
  .ls { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--text3); transition: color .3s; }
  .ls.done { color: var(--text); }
  .ls-dot {
    width: 20px; height: 20px; border-radius: 50%; border: 1.5px solid var(--border2);
    flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    transition: all .3s;
  }
  .ls.done .ls-dot { background: var(--purple); border-color: var(--purple); }
  .ls-check { font-size: 11px; color: white; display: none; }
  .ls.done .ls-check { display: block; }

  /* Results */
  .res-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    padding: 20px; border-bottom: 0.5px solid var(--border);
  }
  .res-level { font-size: 32px; font-weight: 500; color: var(--purple); line-height: 1; }
  .res-level-sub { font-size: 13px; color: #7F77DD; margin-top: 5px; }
  .res-score-num { font-size: 32px; font-weight: 500; color: var(--text); line-height: 1; text-align: right; }
  .res-score-sub { font-size: 12px; color: var(--text3); margin-top: 5px; text-align: right; }

  .gap-banner {
    margin: 16px 20px 0; background: var(--amber-light); border-radius: var(--radius);
    padding: 14px 16px; display: flex; align-items: flex-start; gap: 10px;
  }
  .gap-icon { font-size: 20px; color: var(--amber); flex-shrink: 0; margin-top: 1px; }
  .gap-title { font-size: 12px; font-weight: 500; color: var(--amber-text); margin-bottom: 4px; }
  .gap-text { font-size: 13px; color: var(--amber-text); line-height: 1.55; }

  .metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 16px 20px 0; }
  .mc { background: var(--bg2); border-radius: var(--radius); padding: 12px 14px; }
  .mc-label { font-size: 12px; color: var(--text2); margin-bottom: 6px; }
  .mc-val { font-size: 20px; font-weight: 500; color: var(--text); }
  .mc-val span { font-size: 12px; color: var(--text3); }
  .mc-bar { height: 3px; background: var(--border); border-radius: 2px; margin-top: 8px; }
  .mc-fill { height: 3px; border-radius: 2px; transition: width 1.2s ease; }

  .fb-section { padding: 16px 20px 0; }
  .fb-title { font-size: 13px; font-weight: 500; color: var(--text2); margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
  .fb-item {
    font-size: 14px; line-height: 1.6; color: var(--text);
    padding: 12px 14px; margin-bottom: 8px;
    background: var(--bg2); border-left: 3px solid transparent;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .fb-good { border-left-color: var(--teal); }
  .fb-warn { border-left-color: var(--amber); }

  .checklist { padding: 16px 20px 0; }
  .cl-title { font-size: 13px; font-weight: 500; color: var(--text2); margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
  .cl-row {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 12px 0; border-bottom: 0.5px solid var(--border);
  }
  .cl-row:last-child { border-bottom: none; }
  .cl-dot {
    width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0;
    margin-top: 1px; display: flex; align-items: center; justify-content: center; font-size: 12px;
  }
  .dot-ok { background: var(--teal-light); color: var(--teal-text); }
  .dot-mid { background: var(--amber-light); color: var(--amber-text); }
  .dot-no { background: var(--red-light); color: var(--red-text); }
  .cl-name { font-size: 14px; color: var(--text); }
  .cl-sub { font-size: 12px; color: var(--text3); margin-top: 3px; }

  .res-btns { display: flex; gap: 10px; padding: 20px; }
  .res-btn {
    flex: 1; padding: 13px 10px; border-radius: var(--radius);
    border: 0.5px solid var(--border2); background: transparent;
    font-size: 14px; color: var(--text2); cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 6px;
    transition: background .15s;
  }
  .res-btn:active { background: var(--bg2); }
  .res-btn-main { background: var(--purple); color: white; border-color: var(--purple); font-weight: 500; }
  .res-btn-main:active { background: var(--purple-text); }

  .pb { padding-bottom: 40px; }
</style>
</head>
<body>
<div class="app">

  <!-- 화면 1: 녹음 -->
  <div id="s1" class="screen active">
    <div class="top-nav">
      <div class="nav-logo">opic<span>grade</span></div>
      <div class="nav-badge">🎯 IH → AL</div>
    </div>
    <div class="scroll-body">

      <div class="section-label" style="margin-bottom:8px">API 키 설정</div>
      <div class="api-card">
        <div style="font-size:13px;color:var(--text2);line-height:1.5;">Anthropic API 키를 입력하세요. 이 기기에서만 사용되며 어디에도 전송되지 않아요.</div>
        <div class="api-row">
          <input class="api-input" type="password" id="apiKey" placeholder="sk-ant-..." autocomplete="off" />
          <button class="api-btn" onclick="saveKey()">확인</button>
        </div>
        <div class="api-ok" id="apiOk">✓ 키 확인됨 (이 세션에서만)</div>
      </div>

      <div class="section-label">오늘의 질문</div>
      <div class="q-meta">
        <span class="pill pill-purple">💬 Society & Issues</span>
        <span class="pill pill-amber">AL 빈출 유형</span>
      </div>
      <div class="q-text">Describe a significant social change you have witnessed in your lifetime. What caused it, and what are its long-term implications?</div>

      <div class="al-tip">
        <span class="al-tip-icon">💡</span>
        <div><strong>AL 포인트</strong> — 단순 묘사보다 <em>인과관계 + 장기적 함의</em>까지 논하세요. 반론을 제시하고 재반박하면 AL 화자처럼 들려요.</div>
      </div>

      <div class="section-label">답변 녹음</div>
      <div class="rec-zone" id="rz" onclick="toggleRec()">
        <div class="wave" id="wv">
          <div class="wb" style="height:8px"></div>
          <div class="wb" style="height:18px"></div>
          <div class="wb" style="height:10px"></div>
          <div class="wb" style="height:26px"></div>
          <div class="wb" style="height:14px"></div>
          <div class="wb" style="height:26px"></div>
        </div>
        <button class="mic-btn" id="mb" onclick="event.stopPropagation();toggleRec()" aria-label="녹음 시작/정지">
          <span class="mic-icon" id="micIcon">🎙️</span>
        </button>
        <div class="rec-label" id="rl">탭해서 녹음 시작</div>
        <div class="rec-time" id="rt">00:00</div>
      </div>

      <div class="transcript" id="tr">
        <div class="t-label">인식된 텍스트 (STT)</div>
        <div class="t-text" id="tt">말하기 시작하면 여기에 텍스트가 나타나요...</div>
      </div>

      <button class="btn-primary" id="eb" onclick="goEval()" disabled>✨ AL 기준으로 평가받기</button>
      <div class="err-msg" id="errMsg"></div>
      <button class="btn-secondary" onclick="resetRec()">🔄 다시 녹음하기</button>
      <div class="pb"></div>
    </div>
  </div>

  <!-- 화면 2: 로딩 -->
  <div id="s2" class="screen">
    <div class="top-nav">
      <div class="nav-logo">opic<span>grade</span></div>
    </div>
    <div class="load-body">
      <div class="spinner"></div>
      <div class="load-title">AL 기준으로 분석 중...</div>
      <div class="load-steps">
        <div class="ls done" id="l1">
          <div class="ls-dot"><span class="ls-check">✓</span></div>
          <span>음성 텍스트 변환 완료</span>
        </div>
        <div class="ls" id="l2">
          <div class="ls-dot"><span class="ls-check">✓</span></div>
          <span>논증 구조 분석</span>
        </div>
        <div class="ls" id="l3">
          <div class="ls-dot"><span class="ls-check">✓</span></div>
          <span>고급 어휘 수준 검토</span>
        </div>
        <div class="ls" id="l4">
          <div class="ls-dot"><span class="ls-check">✓</span></div>
          <span>IH vs AL 갭 측정</span>
        </div>
        <div class="ls" id="l5">
          <div class="ls-dot"><span class="ls-check">✓</span></div>
          <span>종합 채점</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 화면 3: 결과 -->
  <div id="s3" class="screen">
    <div class="top-nav">
      <div class="nav-logo">opic<span>grade</span></div>
      <div style="font-size:12px;color:var(--text3);">AI 평가 완료</div>
    </div>
    <div class="scroll-body" style="padding:0;">
      <div class="res-header">
        <div>
          <div style="font-size:12px;color:var(--text3);margin-bottom:5px;">예측 레벨</div>
          <div class="res-level" id="rLevel">-</div>
          <div class="res-level-sub" id="rSub">-</div>
        </div>
        <div>
          <div class="res-score-num"><span id="rScore">-</span><span style="font-size:14px;color:var(--text3);">/100</span></div>
          <div class="res-score-sub">AL 기준 점수</div>
        </div>
      </div>

      <div class="gap-banner">
        <span class="gap-icon">⚡</span>
        <div>
          <div class="gap-title">IH → AL 갭 분석</div>
          <div class="gap-text" id="rGap">-</div>
        </div>
      </div>

      <div class="metrics">
        <div class="mc">
          <div class="mc-label">📚 어휘 수준</div>
          <div class="mc-val" id="mVocab">-</div>
          <div class="mc-bar"><div class="mc-fill" id="mVocabBar" style="width:0%;background:var(--teal)"></div></div>
        </div>
        <div class="mc">
          <div class="mc-label">🌿 논증 구조</div>
          <div class="mc-val" id="mArg">-<span>/100</span></div>
          <div class="mc-bar"><div class="mc-fill" id="mArgBar" style="width:0%;background:var(--purple)"></div></div>
        </div>
        <div class="mc">
          <div class="mc-label">🔀 문장 다양성</div>
          <div class="mc-val" id="mSent">-<span>/100</span></div>
          <div class="mc-bar"><div class="mc-fill" id="mSentBar" style="width:0%;background:var(--amber)"></div></div>
        </div>
        <div class="mc">
          <div class="mc-label">〰️ 유창성</div>
          <div class="mc-val" id="mFluency">-<span>/100</span></div>
          <div class="mc-bar"><div class="mc-fill" id="mFluencyBar" style="width:0%;background:var(--teal)"></div></div>
        </div>
      </div>

      <div class="fb-section">
        <div class="fb-title">✅ AL에 가까운 점</div>
        <div id="fbGood"></div>
        <div class="fb-title" style="margin-top:16px;">📈 AL 도달을 위한 개선점</div>
        <div id="fbWarn"></div>
      </div>

      <div class="checklist">
        <div class="cl-title">☑️ AL 체크리스트</div>
        <div id="alChecks"></div>
      </div>

      <div class="res-btns">
        <button class="res-btn" onclick="goS1()">🔄 재도전</button>
        <button class="res-btn res-btn-main" id="stratBtn">AL 공략법 →</button>
      </div>
      <div class="pb"></div>
    </div>
  </div>

</div>

<script>
let apiKey = '', recDone = false, isRec = false, timerIv, secs = 0, transcript = '', recognition = null;

function saveKey() {
  const v = document.getElementById('apiKey').value.trim();
  if (!v.startsWith('sk-')) { showErr('올바른 Anthropic API 키를 입력해주세요. (sk-ant- 또는 sk- 로 시작)'); return; }
  apiKey = v;
  const ok = document.getElementById('apiOk');
  ok.classList.add('show');
  hideErr();
}

function showErr(msg) {
  const e = document.getElementById('errMsg');
  e.textContent = msg; e.classList.add('show');
}
function hideErr() { document.getElementById('errMsg').classList.remove('show'); }

function toggleRec() {
  if (recDone) return;
  if (!isRec) { startRec(); } else { stopRec(); }
}

function startRec() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) {
    showErr('음성 인식은 Chrome 브라우저에서만 작동해요. Chrome으로 열어주세요.');
    return;
  }
  recognition = new SR();
  recognition.continuous = true;
  recognition.interimResults = true;
  recognition.lang = 'en-US';
  let finalT = '';
  recognition.onresult = (e) => {
    let interim = '';
    for (let i = e.resultIndex; i < e.results.length; i++) {
      if (e.results[i].isFinal) { finalT += e.results[i][0].transcript + ' '; }
      else { interim += e.results[i][0].transcript; }
    }
    document.getElementById('tt').textContent = (finalT + interim) || '(인식 중...)';
    transcript = finalT + interim;
  };
  recognition.onerror = (e) => { showErr('음성 인식 오류: ' + e.error + '. 마이크 권한을 허용했는지 확인해주세요.'); };
  recognition.start();
  isRec = true;
  document.getElementById('mb').classList.add('on');
  document.getElementById('micIcon').textContent = '⏹️';
  document.getElementById('rz').classList.add('recording');
  document.getElementById('rl').textContent = '녹음 중 — 탭해서 정지';
  document.getElementById('rt').style.display = 'block';
  document.getElementById('wv').classList.add('on');
  secs = 0;
  timerIv = setInterval(() => {
    secs++;
    const m = String(Math.floor(secs / 60)).padStart(2, '0');
    const s = String(secs % 60).padStart(2, '0');
    document.getElementById('rt').textContent = m + ':' + s;
  }, 1000);
}

function stopRec() {
  if (recognition) recognition.stop();
  clearInterval(timerIv);
  isRec = false; recDone = true;
  document.getElementById('mb').classList.remove('on');
  document.getElementById('micIcon').textContent = '✅';
  document.getElementById('rz').classList.remove('recording');
  document.getElementById('rl').textContent = '녹음 완료';
  document.getElementById('wv').classList.remove('on');
  document.getElementById('tr').classList.add('show');
  if (!transcript.trim()) document.getElementById('tt').textContent = '텍스트가 인식되지 않았어요. 마이크 권한을 확인하고 다시 시도해보세요.';
  document.getElementById('eb').disabled = false;
}

function resetRec() {
  if (recognition) recognition.stop();
  clearInterval(timerIv);
  isRec = false; recDone = false; transcript = ''; secs = 0;
  document.getElementById('mb').classList.remove('on');
  document.getElementById('micIcon').textContent = '🎙️';
  document.getElementById('rz').classList.remove('recording');
  document.getElementById('rl').textContent = '탭해서 녹음 시작';
  const rt = document.getElementById('rt');
  rt.style.display = 'none'; rt.textContent = '00:00';
  document.getElementById('wv').classList.remove('on');
  document.getElementById('tr').classList.remove('show');
  document.getElementById('tt').textContent = '말하기 시작하면 여기에 텍스트가 나타나요...';
  document.getElementById('eb').disabled = true;
  hideErr();
}

async function goEval() {
  if (!apiKey) { showErr('먼저 API 키를 입력하고 확인 버튼을 눌러주세요.'); return; }
  if (!transcript.trim()) { showErr('녹음된 텍스트가 없어요. 다시 녹음해주세요.'); return; }
  hideErr();

  document.getElementById('s1').classList.remove('active');
  document.getElementById('s2').classList.add('active');

  ['l2', 'l3', 'l4', 'l5'].forEach((id, i) => {
    setTimeout(() => { document.getElementById(id).classList.add('done'); }, 600 + i * 700);
  });

  const prompt = `You are an expert OPIc evaluator. The user is currently IH (Intermediate High) and targeting AL (Advanced Low).

Evaluate this spoken English response:
Question: "Describe a significant social change you have witnessed in your lifetime. What caused it, and what are its long-term implications?"
Response: "${transcript}"

Return ONLY valid JSON, no markdown, no explanation:
{
  "predictedLevel": "IH" or "IH+" or "AL-" or "AL",
  "levelSub": "short Korean phrase e.g. 'AL까지 한 단계'",
  "totalScore": number 0-100,
  "gap": "2-3 sentences in Korean about IH-to-AL gap",
  "vocab": number 0-100,
  "argument": number 0-100,
  "sentence": number 0-100,
  "fluency": number 0-100,
  "goodPoints": ["Korean feedback", "Korean feedback"],
  "improvements": ["Korean feedback", "Korean feedback"],
  "checklist": [
    {"criterion": "추상적 주제 전개", "status": "ok|mid|no", "sub": "Korean note"},
    {"criterion": "고급 어휘 사용", "status": "ok|mid|no", "sub": "Korean note"},
    {"criterion": "문장 구조 다양성", "status": "ok|mid|no", "sub": "Korean note"},
    {"criterion": "반론 제시 및 재반박", "status": "ok|mid|no", "sub": "Korean note"},
    {"criterion": "자연스러운 유창성", "status": "ok|mid|no", "sub": "Korean note"}
  ]
}`;

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01'
      },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        messages: [{ role: 'user', content: prompt }]
      })
    });

    const data = await res.json();

    if (!res.ok) {
      throw new Error(data.error?.message || 'API 오류 ' + res.status);
    }

    const text = data.content[0].text.replace(/```json|```/g, '').trim();
    const r = JSON.parse(text);

    document.getElementById('rLevel').textContent = r.predictedLevel;
    document.getElementById('rSub').textContent = r.levelSub;
    document.getElementById('rScore').textContent = Math.round(r.totalScore);
    document.getElementById('rGap').textContent = r.gap;

    const setMetric = (id, barId, val, suffix) => {
      const n = Math.round(val);
      document.getElementById(id).innerHTML = n + (suffix || '<span>/100</span>');
      setTimeout(() => { document.getElementById(barId).style.width = n + '%'; }, 100);
    };
    setMetric('mVocab', 'mVocabBar', r.vocab, '');
    setMetric('mArg', 'mArgBar', r.argument);
    setMetric('mSent', 'mSentBar', r.sentence);
    setMetric('mFluency', 'mFluencyBar', r.fluency);

    document.getElementById('fbGood').innerHTML = r.goodPoints.map(p =>
      `<div class="fb-item fb-good">${p}</div>`).join('');
    document.getElementById('fbWarn').innerHTML = r.improvements.map(p =>
      `<div class="fb-item fb-warn">${p}</div>`).join('');

    const icons = { ok: '✅', mid: '🟡', no: '❌' };
    const dotClass = { ok: 'dot-ok', mid: 'dot-mid', no: 'dot-no' };
    document.getElementById('alChecks').innerHTML = r.checklist.map(c => `
      <div class="cl-row">
        <div class="cl-dot ${dotClass[c.status]}">${icons[c.status]}</div>
        <div>
          <div class="cl-name">${c.criterion}</div>
          <div class="cl-sub">${c.sub}</div>
        </div>
      </div>`).join('');

    document.getElementById('stratBtn').onclick = () => {
      const msg = `내 OPIc 평가 결과: ${r.predictedLevel} (${Math.round(r.totalScore)}/100점)\n갭 분석: ${r.gap}\n개선 필요: ${r.improvements.join(' / ')}\n\n이 결과를 바탕으로 AL 달성을 위한 구체적인 1주일 공부 계획을 짜줘.`;
      alert('Claude.ai에서 다음 메시지를 입력해보세요:\n\n' + msg);
    };

    setTimeout(() => {
      document.getElementById('s2').classList.remove('active');
      document.getElementById('s3').classList.add('active');
    }, 4000);

  } catch (e) {
    document.getElementById('s2').classList.remove('active');
    document.getElementById('s1').classList.add('active');
    showErr('오류: ' + e.message);
  }
}

function goS1() {
  resetRec();
  document.getElementById('s3').classList.remove('active');
  document.getElementById('s1').classList.add('active');
}

